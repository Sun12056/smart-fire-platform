# 运行模式（严格区分，不允许互相静默降级）：
#   mock : 纯前端本地模拟数据（默认），与后端无关
#   api  : 真实后端 REST（Workers → D1）；后端失败会显式告警，绝不静默回退 mock
#   demo : 后端驱动演示（REST + WebSocket），六阶段处置流程由 Demo Simulation Engine 状态机驱动
VITE_DATA_SOURCE=mock

# api / demo 模式下 Workers 后端地址（本地开发默认 wrangler dev 端口）
VITE_API_BASE_URL=http://localhost:8787

# demo 模式的会话 id（对应 Durable Object 实例名）
VITE_DEMO_SESSION_ID=default
